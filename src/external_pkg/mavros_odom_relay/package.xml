<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mavros_odom_relay</name>
  <version>0.1.0</version>
  <description>
    Relay /mavros/local_position/odom (published by mavros as BEST_EFFORT)
    to /odom (RELIABLE) so that Nav2 controller_server can subscribe with
    its default RELIABLE QoS. Without this relay, Nav2 never receives odom
    and never publishes /cmd_vel.
  </description>
  <maintainer email="dev@example.com">dev</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <depend>nav_msgs</depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>multi_goal_to_gp_goal</exec_depend>

  <exec_depend>python3</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
