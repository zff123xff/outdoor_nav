<?xml version="1.0"?>
<package format="3">
  <name>multi_task_bridge</name>
  <version>0.1.0</version>
  <description>Bridge MultiTask backend messages to agent ExecuteTask service</description>
  <maintainer email="dev@example.com">dev</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>execute_task_server</depend>
  <depend>msg_set_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-shapely</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
