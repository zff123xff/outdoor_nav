# Copy to config.env. Paths are relative to this workspace through env.sh.
ROBOT_NAMESPACE=robot_a
# Unitree firmware DDS domain is commonly 0: verify actual robot setup.
ROS_DOMAIN_ID=0
# Required: the Ethernet interface connected to the dog, e.g. eth0 / enx...
GO2W_NET_IFACE=
# Optional second interface used for MID360/remote ROS discovery.
GO2W_LAN_IFACE=
# Prefer /dev/serial/by-id/...:baud after checking PX4 telemetry baud rate.
FCU_URL=/dev/ttyACM0:230400
